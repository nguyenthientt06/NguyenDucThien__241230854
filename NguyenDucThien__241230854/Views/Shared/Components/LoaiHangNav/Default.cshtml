@model IEnumerable<NguyenDucThien__241230854.Models.LoaiHang>

<div class="menu">
    <ul>
        <li class="active">
            <a asp-controller="Home" asp-action="Index">Nguyễn Đức Thiện</a>
        </li>
        @foreach (var loai in Model)
        {
            <li>
                <a href="javascript:void(0);"
                   class="loai-hang-item"
                   data-maloai="@loai.MaLoai">
                    @loai.TenLoai
                </a>
            </li>
        }
    </ul>
</div>