@model NguyenDucThien__241230854.Models.HangHoa
@{
    ViewData["Title"] = "Thêm Hàng Hóa Mới";
}

<div class="create-hanghoa" style="padding: 15px 0;">
    <div>Nguyễn Đức Thiện</div>
    <h3>Thêm Hàng Hóa Mới</h3>
    <hr />

    <form asp-controller="HangHoa" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color: red; margin-bottom: 10px;"></div>

        <div style="margin-bottom: 10px;">
            <div><label asp-for="MaLoai"></label></div>
            <select asp-for="MaLoai" asp-items="ViewBag.MaLoai" style="padding: 4px; min-width: 180px;"></select>
            <div><span asp-validation-for="MaLoai" style="color: red;"></span></div>
        </div>

        <div style="margin-bottom: 10px;">
            <div><label asp-for="TenHang"></label></div>
            <input asp-for="TenHang" style="padding: 4px; width: 220px;" />
            <div><span asp-validation-for="TenHang" style="color: red;"></span></div>
        </div>

        <div style="margin-bottom: 10px;">
            <div><label asp-for="Gia"></label></div>
            <input asp-for="Gia" type="number" step="any" style="padding: 4px; width: 220px;" />
            <div><span asp-validation-for="Gia" style="color: red;"></span></div>
        </div>

        <div style="margin-bottom: 12px;">
            <div><label asp-for="Anh"></label></div>
            <input asp-for="Anh" style="padding: 4px; width: 220px;" />
            <div><span asp-validation-for="Anh" style="color: red;"></span></div>
        </div>

        <button type="submit" style="padding: 5px 15px; cursor: pointer;">Create</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}