<!DOCTYPE HTML>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
    <title>@ViewData["Title"] - Nguyễn Đức Thiện</title>

    <link href="~/Content/css/style.css" rel="stylesheet" type="text/css" media="all" />
    <link href="~/Content/css/slider.css" rel="stylesheet" type="text/css" media="all" />

    <script src="~/Script/js/jquery-1.7.2.min.js" type="text/javascript"></script>
    <script src="~/Script/js/move-top.js" type="text/javascript"></script>
    <script src="~/Script/js/easing.js" type="text/javascript"></script>
</head>
<body>
    <div class="wrap">
        @await Html.PartialAsync("NguyenDucThien_Header")
        @await Html.PartialAsync("NguyenDucThien_MainContent")

        <div class="main">
            <div class="content">
                @RenderBody()
            </div>
        </div>
    </div>

    @await Html.PartialAsync("NguyenDucThien_Footer")

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
            $(document).on("click", ".loai-hang-item", function (e) {
                e.preventDefault();
                var maLoai = $(this).data("maloai");

                $(".loai-hang-item").parent().removeClass("active");
                $(this).parent().addClass("active");

                $.ajax({
                    url: '@Url.Action("LocTheoLoai", "Home")',
                    type: 'GET',
                    data: { maLoai: maLoai },
                    success: function (result) {
                        $("#hanghoa-container").html(result);
                    },
                    error: function () {
                        alert("Lỗi khi lọc danh sách hàng hóa theo loại.");
                    }
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>